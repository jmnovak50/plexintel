# Copy to ~/.config/plexintel/seerr-discovery.env with owner-only permissions (0600).
# This is inert configuration. Migration and execution require separate operator approval.
SEERR_DISCOVERY_ENABLED=false
# Required for writes: assign one permanent nonsecret ID to this Seerr instance.
# Keep this ID and endpoint unchanged for this inventory; no automatic rebind/adoption.
# SEERR_DISCOVERY_SOURCE_ID=your-permanent-instance-id
SEERR_URL=https://seerr.example.invalid
SEERR_API_KEY_FILE=/path/to/owner-only-seerr-api-key
# Alternatively set SEERR_API_KEY in private configuration/environment, never command arguments.
SEERR_DISCOVERY_LANGUAGES=all
# Movie-only remains the default. Use movie,tv only after the optional unified migration.
SEERR_DISCOVERY_MEDIA_TYPES=movie
SEERR_DISCOVERY_LOOKBACK_DAYS=14
SEERR_DISCOVERY_LOOKAHEAD_DAYS=90
SEERR_DISCOVERY_WINDOW_DAYS=14
SEERR_DISCOVERY_SORT=primary_release_date.asc
SEERR_DISCOVERY_MAX_PAGES=500
SEERR_DISCOVERY_MAX_REQUESTS=10000
SEERR_DISCOVERY_RETRIES=2
SEERR_DISCOVERY_TIMEOUT=25
SEERR_DISCOVERY_INTERVAL=0.3
SEERR_DISCOVERY_MAX_RETRY_AFTER=60
SEERR_DISCOVERY_METADATA_TTL_HOURS=24
SEERR_DISCOVERY_FAILED_RETRY_HOURS=1
SEERR_DISCOVERY_CACHE_ENABLED=true
SEERR_DISCOVERY_REFRESH_BATCH_SIZE=1000
