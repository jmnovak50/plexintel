# Inactive SERVER environment template; never enables discovery by itself.
# These gates are process environment variables, not app_settings or private
# provider-file settings. Deployment/activation requires separate approval.
SEERR_DISCOVERY_WEB_PREVIEW_ENABLED=false
SEERR_DISCOVERY_WEB_WRITES_ENABLED=false
SEERR_DISCOVERY_SCHEDULING_ENABLED=false
# Persistence/dispatch additionally require the existing provider configuration's
# SEERR_DISCOVERY_ENABLED=true. Do not change that setting during UI deployment.
# The existing pipeline scheduler remains the sole in-app scheduling owner.
