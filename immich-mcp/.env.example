IMMICH_BASE_URL=https://photo.example.com
OIDC_ISSUER=https://auth.example.com/application/o/immich-mcp/
OIDC_CLIENT_ID=immich-mcp
OIDC_CLIENT_SECRET=
OIDC_AUDIENCE=immich-mcp
OIDC_REQUIRED_SCOPE=immich.read
MCP_PUBLIC_URL=https://mcp.example.com/mcp
PRIVATE_ACCESS_ENABLED=true
CREDENTIAL_DB_PATH=/data/credentials.sqlite3
CREDENTIAL_ENCRYPTION_KEY=
IDENTITY_NAMESPACE=authentik
ACCOUNT_OIDC_ISSUER=https://auth.example.com/application/o/immich-mcp-account/
ACCOUNT_OIDC_CLIENT_ID=immich-mcp-account
ACCOUNT_OIDC_CLIENT_SECRET=
ACCOUNT_REDIRECT_URI=https://mcp.example.com/account/callback
ACCOUNT_PUBLIC_URL=https://mcp.example.com/account
ACCOUNT_SESSION_SECRET=
ACCOUNT_COOKIE_SECURE=true
ACCOUNT_SESSION_TTL_SECONDS=28800
ACCOUNT_OAUTH_STATE_TTL_SECONDS=600
ACCOUNT_OIDC_SCOPES=openid profile email
PRIVATE_TOOL_MAX_ITEMS=100
TLS_VERIFY=true
HTTP_TIMEOUT_SECONDS=15
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_MAX_RETRIES=2
MAX_IMAGE_BYTES=10000000
GALLERY_INLINE_IMAGE_LIMIT=6
GALLERY_MAX_ITEMS=50
ALLOWED_HOSTS=mcp.example.com,mcp.example.com:*,localhost:*,127.0.0.1:*
ALLOWED_ORIGINS=https://mcp.example.com
LOG_LEVEL=INFO
