ENVIRONMENT=development
DEPLOYMENT_MODE=self_hosted
DATABASE_URL=postgresql+asyncpg://mealie_mcp:change-me@postgres/mealie_mcp

OIDC_ISSUER=https://auth.example.com/application/o/mealie-mcp/
OIDC_AUDIENCE=replace-with-authentik-client-id
OIDC_ALGORITHMS=RS256
OIDC_REQUIRED_SCOPES=mealie.read
IDENTITY_NAMESPACE=authentik
DEFAULT_TENANT_ID=self-hosted

MCP_PUBLIC_URL=https://mealie-mcp.example.com/mcp
MCP_ALLOWED_HOSTS=mealie-mcp.example.com,localhost,127.0.0.1
MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://claude.ai

# Generate once with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key

# Private Mealie destinations are opt-in. This example permits one LAN subnet.
MEALIE_ALLOW_HTTP=false
MEALIE_PRIVATE_NETWORKS=192.168.1.0/24
MEALIE_ALLOWED_HOSTS=
MEALIE_CONNECT_TIMEOUT_SECONDS=5
MEALIE_READ_TIMEOUT_SECONDS=20
MEALIE_MAX_RESPONSE_BYTES=5000000
MEALIE_MAX_SCHEMA_BYTES=10000000
MEALIE_MAX_RETRIES=1
LOG_LEVEL=INFO

